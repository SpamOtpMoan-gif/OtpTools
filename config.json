{
  "delay_seconds": 1.0,
  "proxy_list": [],
  "endpoints": [
    {
      "name": "KFC",
      "url": "https://www.kfc.co.id/api/auth/otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"phone": "__PHONE__", "type": "login"}
    },
    {
      "name": "Gojek",
      "url": "https://api.gojekapi.com/v1/customers/otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"phone": "__PHONE__"}
    },
    {
      "name": "Shopee",
      "url": "https://shopee.co.id/api/v2/authentication/request_otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"mobile": "__PHONE__", "type": "login"}
    },
    {
      "name": "Tokopedia",
      "url": "https://accounts.tokopedia.com/api/v1/otp/request",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"phone": "__PHONE__"}
    },
    {
      "name": "Grab",
      "url": "https://api.grab.com/v1/auth/otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"phone_number": "__PHONE__"}
    },
    {
      "name": "OVO",
      "url": "https://api.ovo.id/v1/auth/otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"mobile": "__PHONE__"}
    },
    {
      "name": "DANA",
      "url": "https://api.dana.id/v1/auth/otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"phone": "__PHONE__"}
    },
    {
      "name": "LinkAja",
      "url": "https://api.linkaja.id/v1/auth/otp",
      "method": "POST",
      "headers": {"Content-Type": "application/json"},
      "template": {"msisdn": "__PHONE__"}
    }
  ]
}
